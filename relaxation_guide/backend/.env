# --- CAPS Backend Environment Configuration ---

# To send real authorization emails to participants' email addresses:
# Option 1 (Gmail App Password):
# 1. Enable 2-Step Verification on your Gmail account.
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Fill in your Gmail address and 16-character App Password below.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@caps-research.org

# --- Teammate Integration Output Paths (Optional) ---
MEMBER1_OUTPUT_PATH=../member1_eeg/output.json
MEMBER2_OUTPUT_PATH=../member2_ring/output.json
MEMBER3_OUTPUT_PATH=../member3_phone/output.json
